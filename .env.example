# GEMINI_API_KEY: Required for Gemini AI API calls (AI Search / Meat Chef Assistant).
# Without this, /api/ai-search still works using a rule-based smart fallback.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Optional real-backend integrations ---
# Everything below is optional. The app runs fully functional with mock/local
# data if these are left unset. Fill in real values to switch on real behavior.

# RAZORPAY (Payments): set VITE_RAZORPAY_KEY_ID to switch Checkout from the
# simulated payment flow to the real Razorpay Checkout widget (test or live key).
# Get one at https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# MSG91 (SMS OTP): set MSG91_API_KEY to send real SMS OTPs on login instead of
# the dev-fallback mode (server logs + returns the code for local testing).
# Get one at https://control.msg91.com/app/dashboard
MSG91_API_KEY="MY_MSG91_API_KEY"
MSG91_SENDER_ID="IGOPRO"

# SUPABASE (Database) — REQUIRED.
# The website now reads its catalog, coupons, offers and combos from the same
# Supabase project the mobile app and the admin dashboard use, and writes orders
# to the same `orders` table. Editing a product in the admin dashboard changes
# the website.
#
# Setup:
#   1. Run supabase/migrations/0004_website_support.sql in the SQL Editor.
#      (It creates igo_* tables only — it never alters an app table.)
#   2. Fill in the two VITE_ values below from
#      https://app.supabase.com -> Project Settings -> API
#
# NOTE: SUPABASE_SERVICE_ROLE_KEY has no VITE_ prefix on purpose — it must only
# ever be read server-side (server.ts). Never expose it to the browser bundle.
# The browser uses the anon key and relies on RLS, exactly like the mobile app.
VITE_SUPABASE_URL="MY_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_URL="MY_SUPABASE_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# CATALOG SOURCE: 'supabase' (default) reads the live, admin-controlled
# `products` table. Set to 'local' to fall back to the 83 hardcoded products in
# src/data/mockData.ts — an instant rollback that needs no code change.
VITE_CATALOG_SOURCE="supabase"
