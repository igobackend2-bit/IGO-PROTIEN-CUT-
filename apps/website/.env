# GEMINI_API_KEY: Required for Gemini AI API calls (AI Search / Meat Chef Assistant).
# Without this, /api/ai-search still works using a rule-based smart fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Optional real-backend integrations ---

# RAZORPAY (Payments) — not yet provided, checkout stays in simulated mode.
VITE_RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# MSG91 (SMS OTP) — not yet provided, OTP stays in dev-fallback mode.
MSG91_API_KEY="MY_MSG91_API_KEY"
MSG91_SENDER_ID="IGOPRO"

